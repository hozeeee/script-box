{
  "name": "script-box-hub",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.7",
  "description": "独立构建的 Script Box 常用脚本下载中心",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm typecheck && node tools/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "pnpm build && node --test tests/*.test.mjs",
    "preview": "node tools/preview.mjs"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "typescript": "^7.0.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
